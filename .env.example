# ---------------------------------------------------------------------------
# Velvet Essence — environment variables
# Copy this file to `.env.local` and fill in your Supabase project values.
# NEVER commit `.env.local` (it is gitignored).
# ---------------------------------------------------------------------------

# Public Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe in the browser — protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY service role key. Bypasses RLS — never expose to the client.
# Only used by privileged server-side admin utilities.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for OAuth redirects + absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
